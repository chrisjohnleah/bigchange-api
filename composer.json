{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "chrisjohnleah/bigchange-api",
    "description": "Framework-agnostic Saloon SDK for the BigChange REST API.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/chrisjohnleah/bigchange-api",
    "keywords": ["bigchange", "jobwatch", "api", "sdk", "saloon", "field-service"],
    "support": {
        "issues": "https://github.com/chrisjohnleah/bigchange-api/issues",
        "source": "https://github.com/chrisjohnleah/bigchange-api"
    },
    "require": {
        "php": "^8.3",
        "saloonphp/saloon": "^4"
    },
    "require-dev": {
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "ChrisJohnLeah\\BigChange\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ChrisJohnLeah\\BigChange\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
